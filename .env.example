# Salin ke .env lalu isi. File .env tidak boleh di-commit.

# Koneksi Postgres (Supabase: Project Settings > Database > Connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Sertifikat CA Supabase (isi PEM; baris baru ditulis sebagai karakter \n).
# Dashboard: Project Settings > Database > SSL Configuration.
DATABASE_CA=""

# URL publik situs (dipakai untuk tautan di email dan metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp toko untuk konfirmasi pembayaran, format internasional tanpa + atau spasi
NEXT_PUBLIC_WHATSAPP_NUMBER="6281357022860"

# Autentikasi (Better Auth). Buat rahasia dengan: npx @better-auth/cli secret  atau  openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Email transaksional (reset password, status pesanan). Isi SMTP *atau* Resend; kosong semua = di dev,
# isi email dicetak ke konsol server.
# Gmail: SMTP_USER = alamat Gmail, SMTP_PASS = App Password 16 huruf (Akun Google > Keamanan >
# Verifikasi 2 Langkah > Sandi aplikasi), bukan password Gmail biasa. Host/port bawaan smtp.gmail.com:465.
# Brevo (tanpa 2 Langkah/domain): SMTP_HOST="smtp-relay.brevo.com", SMTP_PORT="587", SMTP_USER = Login SMTP,
# SMTP_PASS = SMTP key (menu SMTP & API), EMAIL_FROM = alamat pengirim yang sudah diverifikasi di Brevo.
SMTP_USER=""
SMTP_PASS=""
SMTP_HOST=""
SMTP_PORT=""
RESEND_API_KEY=""
# Kosong = "sekenkos.id <SMTP_USER>" (SMTP) atau onboarding@resend.dev (Resend). Untuk Gmail harus alamat Gmail yang sama.
EMAIL_FROM=""

# Tujuan pembayaran manual yang tampil di halaman pesanan
PAYMENT_BANK="BCA 123 456 7890 a.n. Nama Toko"
PAYMENT_EWALLET="DANA 0812-0000-0000 a.n. Nama Toko"
# QRIS statis toko (teks hasil scan QR statis). Aplikasi mengubahnya jadi QRIS dinamis sesuai total pesanan.
PAYMENT_QRIS=""

# Pembayaran online (Midtrans Snap) DINONAKTIFKAN; kodenya masih ada (dikomentari di checkout/actions.ts).
# Dashboard Midtrans: Settings > Access Keys > Server Key. Kunci sandbox berawalan "SB-Mid-server-".
# Payment Notification URL (Settings > Configuration): https://DOMAIN-ANDA/api/webhooks/midtrans
MIDTRANS_SERVER_KEY=""
# "false" = sembunyikan bayar online sementara tanpa menghapus kunci
MIDTRANS_ENABLED="false"

# Ongkir dinamis (Biteship, opsional). Kosong = tarif perkiraan berlabel "estimasi".
# Dashboard Biteship: Integrations > API. Kunci uji berawalan "biteship_test.", kunci asli "biteship_live."
BITESHIP_API_KEY=""
# Kode pos tempat paket dikirim dari toko
SHIPPING_ORIGIN_ZIP="65141"
# Kode kabupaten/kota toko (Kepmendagri, mis. 35.73 = Kota Malang) untuk perkiraan tarif tanpa Biteship
SHIPPING_ORIGIN_REGENCY="35.73"
# Kurir yang ditawarkan (kode Biteship)
BITESHIP_COURIERS="jne,jnt,sicepat,anteraja"
# Pengaman agar tidak nombok: tambahan persen di atas tarif kurir, biaya packing tetap (Rp),
# berat kemasan yang ditambahkan ke berat barang (gram), dan pembulatan ke atas (Rp).
SHIPPING_MARKUP_PERCENT="0"
SHIPPING_PACKING_FEE="0"
SHIPPING_PACKING_GRAMS="200"
SHIPPING_ROUND_TO="500"

# Rahasia untuk endpoint cron (Vercel mengirimnya otomatis sebagai Bearer token)
CRON_SECRET=""
