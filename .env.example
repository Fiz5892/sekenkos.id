# Salin ke .env lalu isi. File .env tidak boleh di-commit.

# Koneksi Postgres (Supabase: Project Settings > Database > Connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Sertifikat CA Supabase (isi PEM; baris baru ditulis sebagai karakter \n).
# Dashboard: Project Settings > Database > SSL Configuration.
DATABASE_CA=""

# URL publik situs (dipakai untuk tautan di email dan metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp toko untuk konfirmasi pembayaran, format internasional tanpa + atau spasi
NEXT_PUBLIC_WHATSAPP_NUMBER="6281200000000"

# Autentikasi (Better Auth). Buat rahasia dengan: npx @better-auth/cli secret  atau  openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Email transaksional (Resend). Kosong = di dev, tautan email dicetak ke konsol server.
RESEND_API_KEY=""
EMAIL_FROM="sekenkos.id <onboarding@resend.dev>"

# Tujuan pembayaran manual yang tampil di halaman pesanan
PAYMENT_BANK="BCA 123 456 7890 a.n. Nama Toko"
PAYMENT_EWALLET="DANA 0812-0000-0000 a.n. Nama Toko"

# Rahasia untuk endpoint cron (Vercel mengirimnya otomatis sebagai Bearer token)
CRON_SECRET=""
